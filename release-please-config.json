{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "susm",
      "include-v-in-tag": true,
      "include-component-in-tag": false,
      "include-v-in-release-name": true,
      "initial-version": "0.1.0",
      "version-file": "version.txt",
      "extra-files": [
        {
          "type": "toml",
          "path": "Cargo.toml",
          "jsonpath": "$.workspace.package.version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value === 'susm-cli' || @.name.value === 'susm-config' || @.name.value === 'susm-controller' || @.name.value === 'susm-diagnostics' || @.name.value === 'susm-domain' || @.name.value === 'susm-host' || @.name.value === 'susm-protocol' || @.name.value === 'susm-supervisor' || @.name.value === 'xtask')].version"
        }
      ],
      "changelog-type": "default",
      "changelog-sections": [
        { "type": "feat", "section": "Features" },
        { "type": "fix", "section": "Bug Fixes" },
        { "type": "perf", "section": "Performance Improvements" },
        { "type": "refactor", "section": "Code Refactoring" },
        { "type": "docs", "section": "Documentation" },
        { "type": "deps", "section": "Dependencies" },
        { "type": "build", "section": "Build System" },
        { "type": "ci", "section": "Continuous Integration" },
        { "type": "chore", "section": "Miscellaneous Chores" }
      ],
      "changelog-path": "CHANGELOG.md",
      "always-update": true,
      "pull-request-title-pattern": "chore: release ${version}",
      "pull-request-header": "Merge this pull request to publish the release.",
      "pull-request-footer": ""
    }
  }
}
